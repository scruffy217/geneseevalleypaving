---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  // Drafts are skipped in production builds but shown in `npm run dev`.
  const guides = await getCollection('guides', ({ data }) => import.meta.env.DEV || !data.draft);
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const site = (Astro.site?.toString() ?? 'https://pavingcompaniesinrochesterny.com/').replace(/\/$/, '');
const fmt = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// No named author on a lead gen site: the business is the author.
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  mainEntityOfPage: `${site}/guides/${entry.id}/`,
  author: { '@type': 'Organization', name: 'Genesee Valley Paving', url: site + '/' },
  publisher: { '@type': 'Organization', name: 'Genesee Valley Paving', url: site + '/' },
}];
---
<BaseLayout title={d.title} description={d.description} schema={schema} ogType="article">
  <section class="hero">
    <Breadcrumbs current={d.title} />
    <h1>{d.title}</h1>
    <p class="meta">{d.updatedDate ? `Updated ${fmt(d.updatedDate)}` : `Published ${fmt(d.pubDate)}`} · Genesee Valley Paving</p>
  </section>
  <article>
    <Content />
    <div class="money">
      Ready to talk about your project? See our <a href={d.moneyPage}>{d.moneyPageLabel}</a> page or call for a free estimate.
    </div>
  </article>
</BaseLayout>

<style>
  .hero { background: var(--black); color: #fff; padding-bottom: 40px; }
  .hero h1 { max-width: 820px; margin: 16px auto 0; padding: 0 16px; font-size: 40px; }
  .meta { max-width: 820px; margin: 12px auto 0; padding: 0 16px; color: var(--muted); font-size: 15px; }
  article { max-width: 820px; margin: 0 auto; padding: 32px 16px 48px; font-size: 18px; line-height: 1.65; }
  article :global(h2) { color: var(--plum); font-size: 28px; margin: 36px 0 12px; }
  .money { background: var(--offwhite); border-left: 4px solid var(--plum); border-radius: 6px; padding: 18px 20px; margin-top: 36px; }
  .money a { color: var(--plum); font-weight: 700; }
</style>
